// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String?
  environment String?
  metadata    String?    // JSON string
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  resources   Resource[]
  variables   Variable[]
  outputs     Output[]
}

model Resource {
  id            String  @id @default(uuid())
  type          String
  name          String
  configuration String  // JSON string
  dependencies  String? // JSON string
  orderIndex    Int     @default(0)
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model Variable {
  id           String  @id @default(uuid())
  name         String
  type         String
  defaultValue String?
  description  String?
  isSensitive  Boolean @default(false)
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Output {
  id          String  @id @default(uuid())
  name        String
  value       String
  description String?
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  author      String?
  version     String   @default("1.0.0")
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resources   TemplateResource[]
  variables   TemplateVariable[]
}

model TemplateResource {
  id            String   @id @default(uuid())
  type          String
  name          String
  configuration String   // JSON string
  orderIndex    Int      @default(0)
  templateId    String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TemplateVariable {
  id           String   @id @default(uuid())
  name         String
  type         String
  defaultValue String?
  description  String?
  templateId   String
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}
